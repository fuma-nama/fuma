{
  "name": "fuma-nama",
  "version": "0.1.1",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter @fumari/sponsors build && next dev",
    "build": "pnpm --filter @fumari/sponsors build && next build",
    "start": "next start",
    "format": "oxfmt",
    "types:check": "pnpm --filter @fumari/sponsors build && pnpm --filter @fumari/sponsors types:check && tsc --noEmit",
    "tegami": "node tegami.mts",
    "db:push": "dotenv -e .env.local -- prisma db push",
    "generate:local": "dotenv -e .env.local -- prisma generate",
    "migrate:dev": "dotenv -e .env.local -- prisma migrate dev",
    "migrate:deploy": "dotenv -e .env.production -- prisma migrate deploy"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.2",
    "@fuma-comment/react": "^1.5.0",
    "@fuma-comment/server": "^1.5.0",
    "@fumari/sponsors": "workspace:*",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@radix-ui/react-scroll-area": "^1.2.14",
    "@shikijs/rehype": "^4.3.1",
    "class-variance-authority": "^0.7.1",
    "feed": "^6.0.0",
    "fuma-content": "^1.4.0",
    "lucide-react": "^1.24.0",
    "next": "16.2.10",
    "next-auth": "5.0.0-beta.25",
    "octokit": "^5.0.5",
    "phenomenon": "^1.6.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "remark-gfm": "^4.0.1",
    "remark-heading-id": "^1.0.1",
    "shiki": "^4.3.1",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@fuma-content/studio": "^2.1.1",
    "@tailwindcss/postcss": "^4.3.2",
    "@tailwindcss/typography": "^0.5.20",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/remark-heading-id": "^1.0.0",
    "dotenv-cli": "^11.0.0",
    "oxfmt": "^0.58.0",
    "postcss": "^8.5.16",
    "prisma": "^7.8.0",
    "tailwindcss": "^4.3.2",
    "tegami": "^1.2.5",
    "typescript": "^6.0.3"
  },
  "packageManager": "pnpm@11.1.3"
}
